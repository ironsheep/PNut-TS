  "rows": [
    {
      "id": "fvar_fvars_encoding",
      "suite": "DAT-PASM-tests",
      "kind": "accept",
      "goldSource": "pnut",
      "file": "fvar_fvars_encoding.spin2",
      "covers": "FVAR/FVARS DAT data: every length boundary of both encodings, both signs (spinResolver.ts FVAR/FVARS size selection)",
      "note": "Adopts the hand-named fixture; the file has no generated header.",
      "source": [
        "'' FVAR / FVARS DAT data: every length boundary of both encodings, both signs.",
        "'' FVAR  emits the RFVAR  form (unsigned, 1..4 bytes, 29 bits max).",
        "'' FVARS emits the RFVARS form (signed, 1..4 bytes, -$1000_0000..$0FFF_FFFF).",
        "'' Reported against v1.55.9: a non-negative FVARS value was rejected as",
        "'' \"FVAR/FVARS data is too big\", and once accepted was encoded by its unsigned",
        "'' length (FVARS 100 as the single byte $64, which RFVARS reads back as -28).",
        "''",
        "'' $EEEE is the end marker.",
        "",
        "DAT",
        "",
        "fvars_vals      byte    FVARS 0                 ' 1 byte",
        "                byte    FVARS 63                ' 1 byte, largest positive",
        "                byte    FVARS 64                ' 2 bytes, smallest positive",
        "                byte    FVARS -64               ' 1 byte, most negative",
        "                byte    FVARS -65               ' 2 bytes",
        "                byte    FVARS 100               ' 2 bytes (the reported case)",
        "                byte    FVARS 8191              ' 2 bytes, largest positive",
        "                byte    FVARS 8192              ' 3 bytes",
        "                byte    FVARS -8192             ' 2 bytes, most negative",
        "                byte    FVARS -8193             ' 3 bytes",
        "                byte    FVARS $F_FFFF           ' 3 bytes, largest positive",
        "                byte    FVARS $10_0000          ' 4 bytes",
        "                byte    FVARS -$10_0000         ' 3 bytes, most negative",
        "                byte    FVARS -$10_0001         ' 4 bytes",
        "                byte    FVARS $0FFF_FFFF        ' 4 bytes, largest legal",
        "                byte    FVARS -$1000_0000       ' 4 bytes, smallest legal",
        "",
        "fvar_vals       byte    FVAR 0                  ' 1 byte",
        "                byte    FVAR 127                ' 1 byte, largest",
        "                byte    FVAR 128                ' 2 bytes",
        "                byte    FVAR $3FFF              ' 2 bytes, largest",
        "                byte    FVAR $4000              ' 3 bytes",
        "                byte    FVAR $1F_FFFF           ' 3 bytes, largest",
        "                byte    FVAR $20_0000           ' 4 bytes",
        "                byte    FVAR $1FFF_FFFF         ' 4 bytes, largest legal",
        "",
        "mixed           byte    1, FVAR 300, 2, FVARS -300, 3",
        "                word    $EEEE"
      ]
    },
    {
      "id": "fvars_too_big",
      "suite": "EXCEPT-tests",
      "kind": "reject",
      "goldSource": "pnut",
      "file": "fvars_too_big.spin2",
